    <element xsi:type="archimate:RealizationRelationship" id="r-reader-c016049" source="e-reader" target="req-cal-016049"/>
    <element xsi:type="archimate:RealizationRelationship" id="r-reader-c016050" source="e-reader" target="req-cal-016050"/>
    <element xsi:type="archimate:RealizationRelationship" id="r-reader-c016052" source="e-reader" target="req-cal-016052"/>
