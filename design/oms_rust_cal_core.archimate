  </folder>
  <folder name="Motivation" id="f-motivation" type="motivation">
    <element xsi:type="archimate:Requirement" name="CAL-005179" id="req-cal-005179">
      <documentation>A C++ CAL Implementation shall implement the methods defined by the C++ CAL Interface Generation Specification (document OMSC-SPC-008).</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="10"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005180" id="req-cal-005180">
      <documentation>A Java CAL Implementation shall implement the methods defined by the Java CAL Interface Generation Specification (document OMSC-SPC-007).</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="10"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005181" id="req-cal-005181">
      <documentation>A CAL Implementation shall generate UUIDs in accordance with the RFC 4122, UUID version 1, 3, and 4.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="14"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005201" id="req-cal-005201">
      <documentation>A CAL Implementation shall have a mechanism for the CAL Client to obtain a fully initialized instance of the CAL associated with a Service Identifier.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="14"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005202" id="req-cal-005202">
      <documentation>A CAL Implementation shall associate a single CAL instance with each unique combination of Service Identifier and ASB Identifier.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="15"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005203" id="req-cal-005203">
      <documentation>A CAL Implementation shall have a mechanism for retrieving the UUIDs that identify the System, Service, Subsystem, Components, and Capabilities associated with the initializing Service.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="15"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005204" id="req-cal-005204">
      <documentation>A CAL Implementation shall report an error to the CAL Client in the event the initialization of the CAL instance fails.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="15"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005208" id="req-cal-005208">
      <documentation>A CAL Implementation shall associate a topic with one and only one CAL Message type.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="15"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005209" id="req-cal-005209">
      <documentation>A CAL Implementation shall map Client Topics to the applicable CAL Topics.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="15"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005210" id="req-cal-005210">
      <documentation>A CAL Implementation shall support the configuration of independent Quality of Service settings for each Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="16"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005254" id="req-cal-005254">
      <documentation>A CAL Implementation shall create optional fields in a disabled state.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="18"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005264" id="req-cal-005264">
      <documentation>CAL Implementation shall create bounded lists in an empty state.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="19"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005267" id="req-cal-005267">
      <documentation>A CAL Implementation shall create choice fields in an uninitialized state.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="19"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005275" id="req-cal-005275">
      <documentation>A CAL Implementation shall have a mechanism for destroying CAL Messages and Sub-messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="19"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005290" id="req-cal-005290">
      <documentation>A CAL Implementation shall have a mechanism to enable or disable optional fields.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="20"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005293" id="req-cal-005293">
      <documentation>A CAL Implementation shall have a mechanism to determine the enabled or disabled state of an optional field.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="20"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005294" id="req-cal-005294">
      <documentation>A CAL Implementation shall indicate to the CAL Client that a field is disabled when a disabled optional field is accessed.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="20"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005296" id="req-cal-005296">
      <documentation>A CAL Implementation shall provide the value of the field when the value of an enabled optional field is accessed.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="20"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005364" id="req-cal-005364">
      <documentation>A CAL Implementation shall have a mechanism to create Writers associated with a Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="22"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005368" id="req-cal-005368">
      <documentation>A CAL Writer Instance shall be associated with one and only one Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="22"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005369" id="req-cal-005369">
      <documentation>A CAL Writer Instance shall report an error upon invocation of the write operation when the associated Client Topic is unavailable.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="22"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005374" id="req-cal-005374">
      <documentation>A CAL Implementation shall have a mechanism to create Readers associated with a Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="23"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005378" id="req-cal-005378">
      <documentation>A CAL Reader Instance shall be associated with one and only one Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="23"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005379" id="req-cal-005379">
      <documentation>A CAL Reader Implementation shall provide a callback interface for receiving CAL Messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="23"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005380" id="req-cal-005380">
      <documentation>A CAL Reader Implementation shall provide a polling interface for receiving CAL Messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="23"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005391" id="req-cal-005391">
      <documentation>A CAL Reader Implementation shall allow a CAL Client to register zero or more listener instances for receiving incoming CAL Messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005392" id="req-cal-005392">
      <documentation>A CAL Reader Implementation shall provide a CAL Client with a single, shared CAL Message reference by invoking the message handler operation of each registered listener instance one time for each received CAL Message instance.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005394" id="req-cal-005394">
      <documentation>A CAL Reader Implementation shall establish the topic connection when the Reader is created.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005396" id="req-cal-005396">
      <documentation>A CAL Implementation shall provide the ability to unregister a listener instance.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="25"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005431" id="req-cal-005431">
      <documentation>A CAL Reader Instance shall provide Time Based Filter Quality of Service such that the CAL Reader drops CAL Messages received on a Client Topic within a specified time period since the last CAL Message was accepted on the Client Topic.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="26"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005434" id="req-cal-005434">
      <documentation>A CAL Implementation shall provide the Reliability Quality of Service such that the CAL Implementation resends CAL Messages on connections to CAL Readers that have not received the CAL Message while the CAL Message remains available for retransmit.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="26"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005437" id="req-cal-005437">
      <documentation>A CAL Implementation shall provide the Expiration Quality of Service such that the CAL Implementation removes expired CAL Messages from the CAL Reader's buffer.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="27"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005444" id="req-cal-005444">
      <documentation>A CAL Implementation shall provide the Message Buffer Quality of Service such that the CAL Implementation will buffer a configurable, maximum number of CAL Messages that the CAL Implementation has received from the CAL Client but not yet delivered to the network connection.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="28"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-005445" id="req-cal-005445">
      <documentation>A CAL Implementation shall remove the oldest message in the CAL Writer's buffer of CAL Messages when the number of CAL Messages exceeds the value configured by the Message Buffer Quality of Service.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="28"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-015746" id="req-cal-015746">
      <documentation>A CAL Implementation shall provide the Message Buffer Quality of Service such that the CAL Implementation will buffer a configurable, maximum number of CAL Messages that the CAL Implementation has received but not yet delivered to the CAL Client.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="28"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016015" id="req-cal-016015">
      <documentation>A CAL Implementation shall provide multiple CAL Clients operating in a single address space with the same behavior as if each CAL Client were executing in separate address spaces.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="10"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016024" id="req-cal-016024">
      <documentation>A CAL Implementation shall represent the xs:integer built-in datatype as a signed 64-bit integer.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="12"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016027" id="req-cal-016027">
      <documentation>A CAL Implementation shall represent the xs:duration built-in datatype as a signed 64-bit integer.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="13"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016028" id="req-cal-016028">
      <documentation>A CAL Implementation shall represent the xs:dateTime built-in datatype as a signed 64-bit integer.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="13"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016029" id="req-cal-016029">
      <documentation>A CAL Implementation shall represent the xs:time built-in datatype as a signed 64-bit integer.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="13"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016033" id="req-cal-016033">
      <documentation>A CAL Implementation shall support the creation of non-abstract CAL Messages and Sub-messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="18"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016035" id="req-cal-016035">
      <documentation>A CAL Implementation shall prevent the creation of abstract CAL Messages and Sub-messages.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="18"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016038" id="req-cal-016038">
      <documentation>A CAL Implementation shall create enumerations in an uninitialized state.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="19"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016043" id="req-cal-016043">
      <documentation>A CAL Writer Instance shall report an error upon invocation of the write operation when the required resources to complete the operation are not available.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="22"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016044" id="req-cal-016044">
      <documentation>A CAL Reader Implementation shall begin buffering received CAL Messages based on the topic QoS Settings when the topic connection is established.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016045" id="req-cal-016045">
      <documentation>A CAL Reader Implementation shall remove the CAL Message instance from the receive buffer once the message handler operation of each registered listener instance has been completed.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016046" id="req-cal-016046">
      <documentation>A CAL Implementation shall make available without modification the CAL Message accessed by the registered listener for the duration of an invoked registered listeners' message handler operation.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="24"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016049" id="req-cal-016049">
      <documentation>A CAL Reader Instance shall block within the read operation until the specified timeout value has expired, a new CAL Message arrives, or the Reader Instance is closed.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="25"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016050" id="req-cal-016050">
      <documentation>A CAL Reader Implementation shall report an error when the read operation is invoked on a Reader Instance with one or more registered listeners.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="25"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016052" id="req-cal-016052">
      <documentation>A CAL Reader Implementation shall remove the CAL Message instance from the receive buffer when the CAL Message is provided to the CAL Client.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="25"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016076" id="req-cal-016076">
      <documentation>A CAL Implementation shall provide the Reliability Quality of Service such that the CAL Implementation preserves the order of CAL Messages on a connection.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="27"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016079" id="req-cal-016079">
      <documentation>A CAL Implementation shall remove the oldest message in the CAL Reader's buffer of CAL Messages when number of CAL Messages exceeds the value configured by the Message Buffer Quality of Service.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="28"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016366" id="req-cal-016366">
      <documentation>Upon successful completion of a request to register as an Abstract Service Bus Connection Status listener, a CAL Implementation shall call the registered class' API notification method with the current state of the ASB connection.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="29"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016477" id="req-cal-016477">
      <documentation>A CAL Implementation shall enforce UUID conformance to RFC 4122.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="13"/>
    </element>
    <element xsi:type="archimate:Requirement" name="CAL-016479" id="req-cal-016479">
      <documentation>A CAL Implementation shall generate variant 1 (Leach-Salz) UUIDs in accordance with the RFC 4122.</documentation>
      <property key="Document" value="OMSC-SPC-001 rev L"/>
      <property key="Page" value="14"/>
    </element>
    <element xsi:type="archimate:Constraint" name="uci namespace" id="id-c6f8d7688bd14a0b9ffc9123635c9663">
      <documentation>The https://www.vdl.afrl.af.mil/programs/oam schema namespace shall map to the &quot;uci&quot; rust namespace.&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="xs namespace" id="id-c61875c97edb47dead97af08036ed0d4">
      <documentation>The http://www.w3.org/2001/XMLSchema schema namespace shall map to the &quot;xs&quot; rust namespace.&#xD;
</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-b6f83f987781477691736beef80d8c6b" type="implementation_migration"/>
